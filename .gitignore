# --- R ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# --- Python ---
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# --- Jupyter ---
.ipynb_checkpoints/

# --- renv: keep renv.lock + activate script; ignore the local library ---
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/sandbox/
renv/python/

# --- targets pipeline stores (one per track) ---
_targets/
stores/

# --- data: raw inputs are referenced, never versioned in git ---
data/source/
data/cache/
data/output/
data/output-wpp/

# raw data formats anywhere; data is tracked with DVC, not git
*.tif
*.tiff
*.nc
*.zarr
*.zarr/
*.parquet

# --- DVC: data content tracked by DVC, not git (.dvc pointers ARE committed) ---
.dvc/cache
.dvc/tmp
.dvc/config.local

# --- containers / build artifacts (Apptainer image and R libraries) ---
*.sif
rlibs/
jobs/*.out
jobs/*.err

# --- HPC job logs ---
hpc-jobs/logs/

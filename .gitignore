# --- R ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj

# --- Python ---
__pycache__/
*.pyc

# --- Jupyter ---
.ipynb_checkpoints/

# --- renv: keep renv.lock + activate script; ignore the local library ---
renv/library/
renv/local/
renv/cellar/
renv/staging/
renv/sandbox/
renv/python/

# --- targets pipeline store ---
_targets/

# --- data: raw inputs are referenced, never versioned in git ---
data/source/
data/cache/
data/output/

# raw data formats anywhere; data is tracked with DVC, not git
*.tif
*.tiff
*.nc
*.zarr
*.zarr/
*.parquet

# --- DVC: data content tracked by DVC, not git (.dvc pointers ARE committed) ---
.dvc/cache
.dvc/tmp
.dvc/config.local
*.sif
*.sif
rlibs/
data/cache/
